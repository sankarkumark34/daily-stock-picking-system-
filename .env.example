# --- API ---
PORT=4000

# sqlite (default, zero setup) or postgres
DB_TYPE=sqlite
SQLITE_PATH=./data/nse-picks.sqlite
# DATABASE_URL=postgres://nse:nse@localhost:5432/nse
DB_SYNC=true

# --- Data provider (NSE archives) ---
DATA_CACHE_DIR=./data/cache
NSE_REQUEST_DELAY_MS=400

# --- Scheduler (IST) ---
SCHEDULER_ENABLED=true
DAILY_RUN_CRON=45 18 * * 1-5
TZ_NAME=Asia/Kolkata

# --- Model defaults ---
MODEL_MAX_PICKS=10
MODEL_MIN_SCORE=72
MODEL_MAX_PER_SECTOR=3
MODEL_MIN_TURNOVER_CR=5
MODEL_MIN_PRICE=30
MODEL_MIN_HISTORY_BARS=220

# --- Stock Analyst (AI layer, optional) ---
# Claude API credentials: set ANTHROPIC_API_KEY (or run `ant auth login`). Without it the
# analyst page still works with the quantitative checklist + headlines; AI notes are off.
# ANTHROPIC_API_KEY=sk-ant-...
ANALYST_MODEL=claude-opus-5
ANALYST_AI_ENABLED=true

# --- Web (Vite) ---
# VITE_API_URL=http://localhost:4000
